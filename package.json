{
  "name": "staywise-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Staywise hotel booking and operations platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,admin\" -c \"blue,green\" \"npm run start:api\" \"npm run start:admin\"",
    "start": "npm run dev",
    "start:api": "npm --workspace=apps/api run start:dev",
    "start:admin": "npm --workspace=apps/admin-web run dev",
    "build:api": "npm --workspace=apps/api run build",
    "build:admin": "npm --workspace=apps/admin-web run build",
    "test": "npm --workspace=apps/api run test",
    "test:api": "npm --workspace=apps/api run test",
    "verify:api": "npm --workspace=apps/api run verify:api",
    "screenshots": "node scripts/capture-screenshots.js"
  },
  "keywords": [
    "hotel-booking",
    "nestjs",
    "react",
    "mongodb"
  ],
  "author": "Staywise Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "puppeteer-core": "^25.14.0"
  }
}
