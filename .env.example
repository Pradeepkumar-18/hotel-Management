# Server & Environment
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:5173

# Database (MongoDB with replica set topology for multi-document transactions)
# For local replica set (e.g., initialized via mongod --replSet rs0 or memory replica set):
MONGODB_URI=mongodb://127.0.0.1:27017/staywise_dev?replicaSet=rs0

# Authentication & Sessions (HttpOnly opaque sessions)
SESSION_SECRET=dev-secret-do-not-use-in-production-minimum-32-chars-long
STAFF_SESSION_COOKIE_NAME=staywise_staff_sid
STAFF_CSRF_COOKIE_NAME=staywise_staff_csrf
GUEST_SESSION_COOKIE_NAME=staywise_guest_sid
STAFF_SESSION_MAX_AGE_SECONDS=43200
STAFF_SESSION_IDLE_SECONDS=1800
GUEST_SESSION_MAX_AGE_SECONDS=7776000
GUEST_SESSION_IDLE_SECONDS=2592000

# Platform Defaults (Integer minor units, currency, timezone, hold duration)
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
HOLD_EXPIRY_MINUTES=10

# Payment Provider (Offline/mock for early phases per ADR-008 and Phase 0/1 gate)
PAYMENT_PROVIDER=offline

# Initial staff account (one-time seed only; set privately, never commit real credentials)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
